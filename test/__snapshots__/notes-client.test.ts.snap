exports[`AC32: offline waiting note disables opening and explains the connection 1`] = `"<div class="flex flex-col gap-4"><p class="text-sm text-muted-foreground">Một lời nhắn cho điều khó nói. Chuyện nghiêm trọng, hai đứa nên nói trực tiếp nhé.</p><section class="flex flex-col gap-3"><h2 class="font-heading text-xl">Gửi cho mình</h2><div class="note-envelope-grid"><div class="note-envelope"><span class="note-envelope-item" data-envelope-state="waiting"><svg class="note-envelope-paper" viewBox="0 0 320 260" aria-hidden="true"><defs><filter id="_R_75_-ink" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency=".045" numOctaves="2" seed="8" result="noise"></feTurbulence><feDisplacementMap in="SourceGraphic" in2="noise" scale="1.5" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap></filter><filter id="_R_75_-grain"><feTurbulence type="fractalNoise" baseFrequency=".07" numOctaves="3" seed="12"></feTurbulence><feColorMatrix type="saturate" values="0"></feColorMatrix><feBlend in="SourceGraphic" mode="multiply"></feBlend></filter><clipPath id="_R_75_-paper"><path d="M9 39Q159 42 311 38L309 250Q160 247 10 251Z"></path></clipPath><linearGradient id="_R_75_-wash" x2=".6" y2="1"><stop stop-color="var(--envelope-paper)"></stop><stop offset=".6" stop-color="var(--envelope-paper)"></stop><stop offset="1" stop-color="var(--envelope-shade)"></stop></linearGradient><radialGradient id="_R_75_-wax" cx=".35" cy=".25" r=".8"><stop stop-color="var(--envelope-wax-light)"></stop><stop offset=".65" stop-color="var(--envelope-wax)"></stop><stop offset="1" stop-color="var(--envelope-wax-dark)"></stop></radialGradient><g id="_R_75_-seal"><path d="M-24-9Q-23-24-10-26Q1-31 12-25Q27-24 27-9Q33 2 25 13Q24 28 8 28Q-4 33-16 25Q-29 22-27 8Q-33 0-24-9Z" fill="url(#_R_75_-wax)" stroke="var(--envelope-wax-dark)" stroke-width="2"></path><circle r="21" fill="none" stroke="var(--envelope-wax-dark)" stroke-width="2"></circle><path d="M0 13C-27-4-8-20 0-8C9-21