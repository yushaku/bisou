{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bisou",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One hourly trigger; jobs dispatch by Vietnam hour in src/worker/index.ts.
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bisou",
      "database_id": "0107d312-ce81-4920-9b86-26828009aad1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "bisou" }],
  // Push sending (ADR 0010). Create once before the first deploy: wrangler queues create bisou
  "queues": {
    "producers": [{ "binding": "PUSH_QUEUE", "queue": "bisou" }],
    "consumers": [{ "queue": "bisou", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 3 }]
  }
}
