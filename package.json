{
  "name": "bisou",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "node scripts/dev-phone.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run && node --test test/design-system.test.mjs test/pwa-assets.test.mjs scripts/check-migrations.test.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "db:migrate:local": "wrangler d1 migrations apply bisou --local",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "hono": "^4.13.16",
    "lucide-react": "^1.67.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-easy-crop": "6.2.4",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
