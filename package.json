{
  "name": "bisou",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "node scripts/dev-seed-garden.mjs",
    "dev:phone": "node scripts/dev-phone.mjs",
    "build": "vite build && node --test test/client-bundle.test.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test test/design-system.test.mjs test/pwa-assets.test.mjs scripts/check-migrations.test.mjs scripts/dev-seed-garden.test.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "db:migrate:local": "wrangler d1 migrations apply bisou --local",
    "deploy": "pnpm run build && wrangler deploy",
    "prepare": "simple-git-hooks",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@tanstack/query-async-storage-persister": "^5.108.2",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-query-persist-client": "^5.108.2",
    "@yusufceng1z/ding-react": "^0.0.9",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "hono": "^4.13.20",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-easy-crop": "6.2.5",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "knip": "^6.47.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{css,json,jsonc}": "prettier --write"
  }
}
