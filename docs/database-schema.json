    "views": [
      {
        "id": "pairing",
        "label": "Identity and pairing",
        "focus": ["users", "sessions", "couples", "couple_members", "pair_codes"],
        "note": "A user belongs to at most one couple; couple_members is the join and enforces one membership per user."
      },
      {
        "id": "journal",
        "label": "Journal and photos",
        "focus": ["couples", "journal_entries", "photos", "wishes", "wish_claims"],
        "note": "Photos hang off a journal entry, a wish, or neither while an upload is still pending."
      },
      {
        "id": "garden",
        "label": "Garden levels",
        "focus": ["couples", "garden_levels", "garden_days", "garden_answers", "garden_growth"],
        "note": "garden_levels is one row per couple; days, answers and growth are keyed by couple plus day or card."
      },
      {
        "id": "delivery",
        "label": "Events and push",
        "focus": ["users", "couples", "couple_events", "push_subscriptions"],
        "note": "Shared events belong to the couple; push subscriptions belong to the individual device owner."
      }
    ]
