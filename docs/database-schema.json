  "cards": [
    {
      "dot": "cyan",
      "title": "Source of truth",
      "items": [
        "All 20 tables come from the additive migrations 0001–0012 on Cloudflare D1 (SQLite).",
        "INTEGER · epoch ms columns store Unix milliseconds; date columns store YYYY-MM-DD text with a CHECK glob.",
        "Enum values behind “TEXT · enum” are enforced with CHECK constraints, not a lookup table."
      ]
    },
    {
      "dot": "amber",
      "title": "Links without a foreign key",
      "items": [
        "otp_codes.email and otp_requests.email match users.email, but the DDL declares no FK.",
        "garden_growth.day is not an FK to garden_days because its key is the composite (couple_id, day).",
        "At most two couple_members rows per couple is enforced by the join statement, not a constraint."
      ]
    },
    {
      "dot": "emerald",
      "title": "One-to-one and optional ends",
      "items": [
        "Unique FKs make pair_codes, wish_claims, photos.wish_id and garden_levels one-to-one; couple_members.user_id is unique too.",
        "Dashed links are optional: photos may be unattached, a claim survives its wish deletion, and proposer_id can be NULL.",
        "couples.created_by uses ON DELETE SET NULL, so the creator link can disappear while the couple remains."
      ]
    },
    {
      "dot": "violet",
      "title": "Cleanup and partial indexes",
      "items": [
        "otp_codes, sessions, otp_requests, join_attempts and wish_spins are swept daily by expires_at or created_at indexes.",
        "Photos are split by attachment with partial indexes: photos_entry, photos_wish and photos_pending.",
        "garden_days_flipped and wish_claims_gone cover only the rows the pending work queries."
      ]
    }
  ]
}
