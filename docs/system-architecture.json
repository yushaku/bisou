  "cards": [
    {
      "dot": "cyan",
      "title": "Release",
      "items": [
        "Pushing main runs Deploy production, unless only *.md or docs/ changed",
        "typecheck, test and build, then check:migrations",
        "Destructive migrations stop the release for PO review",
        "D1 migrations apply before the Worker deploys",
        "Docs changes publish the docs site; other branches and PRs run CI only"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data",
      "items": [
        "D1 holds users, sessions, couples, events, journal, wishes, notes, card_box_unlocks",
        "R2 photos only via the Worker after a session and couple check",
        "Push jobs wait in Queue bisou up to 24 hours, with no endpoint or keys",
        "Card box text ships in Worker code; the phone caches boxes for offline play"
      ]
    },
    {
      "dot": "rose",
      "title": "Secrets and auth",
      "items": [
        "GitHub production env: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID",
        "Worker secrets: RESEND_API_KEY, OTP_PEPPER, VAPID_PRIVATE_KEY",
        "Email OTP via Resend; session cookie bisou_session, 90 days, sliding"
      ]
    },
    {
      "dot": "amber",
      "title": "Minute cron",
      "items": [
        "Every minute: send due kind notes by push",
        "07:00 note reminders; 08:00 and 20:00 event reminders",
        "03:00: cleans D1 rows and R2 photos"
      ]
    }
  ]
